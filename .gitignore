# 依赖与构建产物
node_modules/
release/
release-test/
release-test2/
dist/
out/
*.log
npm-debug.log*
yarn-error.log*

# 便携模式 / 运行时数据（绝不入库）
PodcastsLearningData/
portable.flag
portable-data/
cache/
*.tmp

# 生成的示例媒体与验证截图（npm run sample 可随时重新生成）
samples/

# 用户媒体与字幕（避免误提交大文件）
*.mp4
*.mkv
*.mp3
*.wav
*.m4a
*.webm
!build/**/*.png

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 其他
*.local
.env
.env.*

# 注意：本仓库**不内置任何 API Key**。历史上曾用 src/main/default-key.js
# 在构建时内嵌出厂 Key，现已移除；本地若残留该文件也不会被 require，但请勿提交。
default-key.js
src/main/default-key.js

# 生成的离线词典（npm run dict 可重建，数据源 ECDICT）
resources/local-dict.json
resources/local-dict.json.gz
.tmp-dict/
release-public/

# 升级测试用的临时目录（内含完整 exe，绝不入库）
tmp-upd/
tmp-*/

# Flutter / Dart 构建产物（mobile/ 子工程，绝不入库）
/mobile/.dart_tool/
/mobile/build/
/mobile/.flutter-plugins
/mobile/.flutter-plugins-dependencies
/mobile/.idea/
/mobile/android/.gradle/
